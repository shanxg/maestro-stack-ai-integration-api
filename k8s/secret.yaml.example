# src/k8s/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: maestro-api-secret
  namespace: default
type: Opaque
data:
  # Cryptographic secret token hashed securely in Base64 pattern layout
  jwt-secret: REPLACE_ME_WITH_STRONG_RANDOM_VALUE
  # PostgreSQL password read by the API (CRED-04), also Base64-encoded
  postgres-password: REPLACE_ME_WITH_STRONG_RANDOM_VALUE
  # RabbitMQ account read by the API (CRED-05), also Base64-encoded; the user must not be guest
  rabbit-user: REPLACE_ME_WITH_BROKER_USER
  rabbit-password: REPLACE_ME_WITH_STRONG_RANDOM_VALUE
  # Redis password read by the API (CRED-06), also Base64-encoded; the Redis server must use the same value
  redis-password: REPLACE_ME_WITH_STRONG_RANDOM_VALUE