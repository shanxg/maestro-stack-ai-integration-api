# Copy this file to .env and fill in the values. Never commit .env (it is gitignored).
# src/config.ts validates these variables when the API starts and stops it if one is
# missing or invalid. Variables left uncommented are required. Commented ones show the
# default src/config.ts uses when the variable is not set.

# --- API ---
# Required, at least 32 characters (RFC 7518, section 3.2). The API refuses to start without it (CRED-02).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# PORT=3000
# NODE_ENV=development

# --- PostgreSQL ---
# Required: there is no default password (CRED-04). docker-compose.yml uses the same
# variable to create the local container, so set it before the first `npm run infra:up`.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# The other defaults match the local container in docker-compose.yml.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres

# --- Redis and RabbitMQ ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# RABBIT_HOST=localhost
# RABBIT_PORT=5672
# Required: the RabbitMQ account (CRED-05). docker-compose.yml creates it on the broker's first
# start, so the default guest user never exists; `guest` is rejected by src/config.ts.
RABBIT_USER=
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
RABBIT_PASSWORD=

# --- AI chat ---
# The defaults point to a local Ollama server, which does not need a real key.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# Model name sent to that server (for example gpt-4o-mini on the OpenAI platform).
# OPENAI_MODEL=llama3

# --- Legacy worker blueprint (src/worker-deprecated.ts) ---
# WORKER_SOCKET_PORT=3002

# --- Python tooling ---
# sync_backlog.py: fine-grained token limited to this repository,
# with Issues read and write (CRED-03).
GITHUB_TOKEN=
# sync_backlog.py: classic token with read:project scope (CRED-03).
GITHUB_PROJECT_TOKEN=
