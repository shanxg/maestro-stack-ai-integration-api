# Copy this file to .env and fill in the values. Never commit .env (it is gitignored).
# Variables left uncommented are required. Commented ones show the default the code
# uses when the variable is not set.

# --- API (src/app.ts, src/middlewares/authMiddleware.ts) ---
# Required: the API refuses to start without it (CRED-02).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# PORT=3000
# NODE_ENV=development

# --- PostgreSQL (src/repositories/UserRepository.ts) ---
# The defaults match the local container in docker-compose.yml.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=postgres

# --- Redis and RabbitMQ (UserController, EventBrokerService) ---
# REDIS_HOST=localhost
# RABBIT_HOST=localhost

# --- AI chat (src/services/AIService.ts) ---
# The defaults point to a local Ollama server, which does not need a real key.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=

# --- Legacy worker blueprint (src/worker-deprecated.ts) ---
# WORKER_SOCKET_PORT=3002

# --- Python tooling ---
# sync_backlog.py: fine-grained token limited to this repository,
# with Issues read and write (CRED-03).
GITHUB_TOKEN=
# delete-issues.py only.
# GITHUB_TOKEN_DELETE=
